# LotPilot environment variables — ALL OPTIONAL.
# The demo runs fully offline with a deterministic matcher and canned reasoning
# when no keys are present. Add a key to switch on live LLM reasoning.

# --- LLM (optional). First one found wins. ---
# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Store extraction (optional). Fixtures and JSON-LD work without keys. ---
# Google Places API (New): direct Google Maps listing lookup.
GOOGLE_MAPS_API_KEY=
# Tavily web research: Maps listing fallback and extra classifier text.
TAVILY_API_KEY=

# --- Analytics (optional). Stubbed out if empty. ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Commerce Layer (optional). Falls back to a clean mock order if empty. ---
COMMERCE_LAYER_CLIENT_ID=
COMMERCE_LAYER_ENDPOINT=

# --- Supabase wholesale RAG (optional). Falls back to seeded index + Tavily. ---
NEXT_PUBLIC_SUPABASE_URL=https://lmfvzuvhwvjpdfkoqqvc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role only for scripts/ingest-wholesale.mjs (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Embeddings: leave unset for local-hash-v1 (matches default ingest). Set to openai after re-ingest.
WHOLESALE_EMBED_MODEL=
